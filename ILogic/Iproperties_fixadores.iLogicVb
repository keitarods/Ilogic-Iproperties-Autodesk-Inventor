Public Function PerguntarPassoFixador() As String
    Return ObterValorListaEditavelSempre("Passo", _
                                         "Passo do parafuso", _
                                         "Selecione um passo existente:", _
                                         "Ou digite um novo passo:", _
                                         "passos_fixador.txt", _
                                         "0,50 mm" & vbCrLf & _
                                         "0,70 mm" & vbCrLf & _
                                         "0,75 mm" & vbCrLf & _
                                         "0,80 mm" & vbCrLf & _
                                         "1,00 mm" & vbCrLf & _
                                         "1,25 mm" & vbCrLf & _
                                         "1,50 mm" & vbCrLf & _
                                         "1,75 mm" & vbCrLf & _
                                         "2,00 mm" & vbCrLf & _
                                         "2,50 mm" & vbCrLf & _
                                         "3,00 mm" & vbCrLf & _
                                         "UNC" & vbCrLf & _
                                         "UNF" & vbCrLf & _
                                         "UNS", _
                                         "1,00 mm")
End Function

Public Function ObterComprimentoFixadorDaPeca(ByVal oDoc As PartDocument) As String
    Try
        Dim p As Parameter
        p = oDoc.ComponentDefinition.Parameters.Item("Comprimento")

        Dim mm As Double
        mm = Round(p.Value * 10, 2)

        Return Replace(CStr(mm), ".", ",") & " mm"
    Catch
    End Try

    Return LerIPropertyCustom("Comprimento", "")
End Function

Public Function PerguntarMaterialFixador() As String
    Return ObterValorListaEditavelSempre("MaterialLegenda", _
                                         "Material do fixador", _
                                         "Selecione o material:", _
                                         "Ou digite um novo material:", _
                                         "materiais_fixadores.txt", _
                                         "Aço carbono" & vbCrLf & _
                                         "Aço inox" & vbCrLf & _
                                         "Latão", _
                                         "Aço carbono")
End Function

Public Function PerguntarSetorChecklist() As String
    Dim opcoes As New System.Collections.ArrayList
    opcoes.Add("Mecânica")
    opcoes.Add("Elétrica/Eletrônica")
    opcoes.Add("Hidraúlica")
    opcoes.Add("IA")

    Dim atual As String
    atual = LerIPropertyCustom("Setor", "")

    Dim frm As New System.Windows.Forms.Form()
    frm.Text = "Setor"
    frm.Width = 420
    frm.Height = 320
    frm.StartPosition = System.Windows.Forms.FormStartPosition.CenterScreen

    Dim chk As New System.Windows.Forms.CheckedListBox()
    chk.Left = 20 : chk.Top = 20 : chk.Width = 360 : chk.Height = 170
    chk.CheckOnClick = True
    For Each item As String In opcoes
        chk.Items.Add(item)
    Next

    If atual <> "" Then
        For i As Integer = 0 To chk.Items.Count - 1
            If InStr(1, atual, chk.Items(i).ToString(), vbTextCompare) > 0 Then chk.SetItemChecked(i, True)
        Next
    End If

    Dim txt As New System.Windows.Forms.TextBox()
    txt.Left = 20 : txt.Top = 205 : txt.Width = 360

    Dim ok As New System.Windows.Forms.Button()
    ok.Text = "OK" : ok.Left = 220 : ok.Top = 240 : ok.Width = 75 : ok.DialogResult = System.Windows.Forms.DialogResult.OK

    Dim cancel As New System.Windows.Forms.Button()
    cancel.Text = "Cancelar" : cancel.Left = 305 : cancel.Top = 240 : cancel.Width = 75 : cancel.DialogResult = System.Windows.Forms.DialogResult.Cancel

    frm.Controls.Add(chk)
    frm.Controls.Add(txt)
    frm.Controls.Add(ok)
    frm.Controls.Add(cancel)

    frm.AcceptButton = ok
    frm.CancelButton = cancel

    If frm.ShowDialog() <> System.Windows.Forms.DialogResult.OK Then Return ""

    Dim sel As New System.Collections.ArrayList
    For i As Integer = 0 To chk.CheckedItems.Count - 1
        sel.Add(chk.CheckedItems(i).ToString())
    Next

    If Trim(txt.Text) <> "" Then sel.Add(Trim(txt.Text))

    Dim resultado As String
    resultado = String.Join("; ", CType(sel.ToArray(GetType(String)), String()))
    Return resultado
End Function

Public Function PerguntarTratamentoChecklist() As String
    Return ObterValorListaEditavelSempre("Tratamento", _
                                         "Tratamento", _
                                         "Selecione tratamento:", _
                                         "Ou digite novo tratamento:", _
                                         "tratamentos_fixadores.txt", _
                                         "Sem tratamento" & vbCrLf & _
                                         "Zincado" & vbCrLf & _
                                         "Galvanizado", _
                                         "Sem tratamento")
End Function

Public Function LerIPropertyCustom(ByVal nomeProp As String, ByVal valorPadrao As String) As String
    Try
        Return CStr(iProperties.Value("Custom", nomeProp))
    Catch
        Return valorPadrao
    End Try
End Function

Public Function ObterValorListaEditavelSempre(ByVal nomeIprop As String, _
                                              ByVal titulo As String, _
                                              ByVal msgLista As String, _
                                              ByVal msgNovo As String, _
                                              ByVal nomeArquivo As String, _
                                              ByVal itensPadrao As String, _
                                              ByVal valorPadrao As String) As String

    Dim pasta As String
    pasta = "C:\Inventor_iLogic\listas"

    If Not System.IO.Directory.Exists(pasta) Then
        Try
            System.IO.Directory.CreateDirectory(pasta)
        Catch
        End Try
    End If

    Dim arq As String
    arq = System.IO.Path.Combine(pasta, nomeArquivo)

    If Not System.IO.File.Exists(arq) Then
        Try
            System.IO.File.WriteAllText(arq, itensPadrao)
        Catch
        End Try
    End If

    Dim conteudo As String
    conteudo = itensPadrao
    Try
        conteudo = System.IO.File.ReadAllText(arq)
    Catch
    End Try

    Dim itens() As String
    itens = Split(conteudo, vbCrLf)

    Dim itensLimpos As New System.Collections.ArrayList
    For Each item As String In itens
        If Trim(item) <> "" Then itensLimpos.Add(Trim(item))
    Next

    Dim atual As String
    atual = LerIPropertyCustom(nomeIprop, valorPadrao)

    Dim escolhido As String
    escolhido = InputListBox(msgLista, itensLimpos, atual, titulo, "Lista")

    If Trim(escolhido) = "" Then
        escolhido = InputBox(msgNovo, titulo, atual)
    End If

    escolhido = Trim(escolhido)
    If escolhido = "" Then Return ""

    Dim existe As Boolean
    existe = False
    For Each item As String In itensLimpos
        If UCase(Trim(item)) = UCase(escolhido) Then
            existe = True
            Exit For
        End If
    Next

    If Not existe Then
        Try
            System.IO.File.AppendAllText(arq, vbCrLf & escolhido)
        Catch
        End Try
    End If

    iProperties.Value("Custom", nomeIprop) = escolhido
    Return escolhido
End Function