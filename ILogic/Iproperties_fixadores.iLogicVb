AddReference "System.Windows.Forms"
AddReference "System.Drawing"

Sub Main()
    Dim oDoc As PartDocument
    oDoc = ThisDoc.Document

    If oDoc.DocumentType <> DocumentTypeEnum.kPartDocumentObject Then
        MessageBox.Show("Esta regra deve ser executada em um arquivo .ipt.", "Erro iLogic")
        Return
    End If

    Dim tipoFixador As String
    Dim grauResistencia As String
    Dim comprimentoFixador As String
    Dim passoFixador As String
    Dim materialLegenda As String
    Dim tratamento As String
    Dim dureza As String
    Dim setor As String
    Dim codigo As String

    ' 1) Fluxo específico de fixadores primeiro
    tipoFixador = PerguntarDetalheTipoFixador(PerguntarTipoFixador())
    If Trim(tipoFixador) = "" Then Return

    ' 2) Grau de resistência
    grauResistencia = PerguntarGrauResistenciaFixador()
    If Trim(grauResistencia) = "" Then grauResistencia = "N/A"

    ' 3) Comprimento via parâmetro do Inventor (somente para parafuso)
    comprimentoFixador = ""
    If InStr(1, tipoFixador, "Parafuso", vbTextCompare) > 0 Then
        comprimentoFixador = ObterComprimentoFixadorDaPeca(oDoc)
    End If

    ' 4) Passo
    passoFixador = PerguntarPassoFixador()
    If Trim(passoFixador) = "" Then passoFixador = "N/A"

    ' 5) Variáveis comuns depois
    materialLegenda = PerguntarMaterialFixador()
    If Trim(materialLegenda) = "" Then
        MessageBox.Show("Nenhum material foi informado. A regra será encerrada.", "iLogic")
        Return
    End If

    tratamento = PerguntarTratamentoChecklist()
    If Trim(tratamento) = "" Then tratamento = "N/A"

    dureza = InputBox("Informe a dureza (opcional):", "Dureza", LerIPropertyCustom("Dureza", ""))
    If Trim(dureza) = "" Then dureza = "N/A"

    setor = PerguntarSetorChecklist()
    If Trim(setor) = "" Then setor = "N/A"

    codigo = InputBox("Informe o código da peça:", "Código", LerIPropertyCustom("Código", ""))
    If Trim(codigo) = "" Then
        MessageBox.Show("Nenhum Código foi informado. A regra será encerrada.", "iLogic")
        Return
    End If

    ' Gravação de iProperties
    iProperties.Value("Custom", "TipoItem") = "Fixadores"
    iProperties.Value("Custom", "Tipo_fixador") = tipoFixador
    iProperties.Value("Custom", "GrauResistencia") = grauResistencia
    iProperties.Value("Custom", "Passo") = passoFixador
    iProperties.Value("Custom", "MaterialLegenda") = materialLegenda
    iProperties.Value("Custom", "Tratamento") = tratamento
    iProperties.Value("Custom", "Dureza") = dureza
    iProperties.Value("Custom", "Setor") = setor
    iProperties.Value("Custom", "Código") = codigo
    iProperties.Value("Custom", "AcabamentoLista") = "N/A"
    iProperties.Value("Custom", "Processos") = "N/A"

    If Trim(comprimentoFixador) <> "" Then
        iProperties.Value("Custom", "Comprimento") = comprimentoFixador
        iProperties.Value("Custom", "ComprimentoLegenda") = comprimentoFixador
    End If

    Dim desc As String
    desc = UCase(materialLegenda) & " - " & tipoFixador
    If Trim(comprimentoFixador) <> "" Then desc = desc & " x " & comprimentoFixador
    If passoFixador <> "N/A" Then desc = desc & " - Passo " & passoFixador
    If grauResistencia <> "N/A" Then desc = desc & " - Classe " & grauResistencia

    iProperties.Value("Custom", "DescricaoAutomatica") = desc
    iProperties.Value("Project", "Description") = desc

    InventorVb.DocumentUpdate()
    MessageBox.Show("iProperties de fixadores atualizadas com sucesso.", "Concluído")
End Sub

Public Function PerguntarTipoFixador() As String
    Return ObterValorListaEditavelSempre("Tipo_fixador", _
                                         "Tipo de fixador", _
                                         "Selecione o tipo de fixador:", _
                                         "Ou digite um novo tipo:", _
                                         "tipos_fixadores.txt", _
                                         "Parafuso" & vbCrLf & _
                                         "Porca" & vbCrLf & _
                                         "Arruela" & vbCrLf & _
                                         "Anel elástico" & vbCrLf & _
                                         "Cupilha", _
                                         "Parafuso")
End Function

Public Function PerguntarDetalheTipoFixador(ByVal tipoFixadorBase As String) As String
    Dim t As String
    t = Trim(tipoFixadorBase)
    If t = "" Then Return ""

    If InStr(1, t, "Parafuso", vbTextCompare) > 0 Then
        Return "Parafuso - " & ObterValorListaEditavelSempre("Detalhe_fixador", _
                                                              "Cabeça do parafuso", _
                                                              "Selecione o tipo de cabeça:", _
                                                              "Ou digite um novo tipo:", _
                                                              "tipos_cabeca_parafuso.txt", _
                                                              "Sextavado" & vbCrLf & _
                                                              "Allen" & vbCrLf & _
                                                              "Phillips" & vbCrLf & _
                                                              "Torks", _
                                                              "Sextavado")
    End If

    If InStr(1, t, "Porca", vbTextCompare) > 0 Then
        Return "Porca - " & ObterValorListaEditavelSempre("Detalhe_fixador", _
                                                           "Tipo de porca", _
                                                           "Selecione o tipo de porca:", _
                                                           "Ou digite um novo tipo:", _
                                                           "tipos_porca.txt", _
                                                           "Comum" & vbCrLf & _
                                                           "Parlock" & vbCrLf & _
                                                           "Torque", _
                                                           "Comum")
    End If

    If InStr(1, t, "Arruela", vbTextCompare) > 0 Then
        Return "Arruela - " & ObterValorListaEditavelSempre("Detalhe_fixador", _
                                                             "Tipo de arruela", _
                                                             "Selecione o tipo de arruela:", _
                                                             "Ou digite um novo tipo:", _
                                                             "tipos_arruela.txt", _
                                                             "Lisa aba comum" & vbCrLf & _
                                                             "Lisa aba larga" & vbCrLf & _
                                                             "pressão", _
                                                             "Lisa aba comum")
    End If

    Return t
End Function

