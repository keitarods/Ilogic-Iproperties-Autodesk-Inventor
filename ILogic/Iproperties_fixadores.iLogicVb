                                         "Grau de resistência", _
                                         "Selecione o grau de resistência:", _
                                         "Ou digite um novo valor:", _
                                         "grau_resistencia_fixador.txt", _
                                         "5.8" & vbCrLf & _
                                         "6.8" & vbCrLf & _
                                         "8.8" & vbCrLf & _
                                         "9.8" & vbCrLf & _
                                         "10.9" & vbCrLf & _
                                         "12.9", _
                                         "8.8")
